{
  "name": "@webpanel/wpp-dev-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone local development and packaging studio for WebPanel WPP plugins.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "wpp:validate": "node scripts/wpp-plugin.mjs validate",
    "wpp:pack": "node scripts/wpp-plugin.mjs pack"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
